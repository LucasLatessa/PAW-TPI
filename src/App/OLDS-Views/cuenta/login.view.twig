<!DOCTYPE html>
<html lang="es"> <head>
    {% include 'parts/head.view.twig' %}
    <link rel="stylesheet" href="/assets/styles/login.css" />
</head>
<body>
    {% include 'parts/header.view.twig' %}
    
    <main class="main-login">
        <section class="login-container">
            <h1>Iniciar Sesión</h1>
            
            <form action="" method="post" class="login-form">
                <div class="form-group">
                    <label for="email">Correo Electrónico</label>
                    <input type="email" id="email" name="email" placeholder="ejemplo@correo.com" required>
                </div>
                
                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="password"  required>
                </div>
                
                <button type="submit" value="login" class="btn-login">Ingresar</button>
            </form>

            <div class="registro-container">
                <small class="registro-selec">¿No tenés cuenta?</small>
                <a href="/cuenta/registrarse" class="register-link">Crear una cuenta nueva</a>
            </div>
        </section>
    </main>

    {% include 'parts/footer.view.twig' %}
</body>
</html>