<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ title }}{% endblock %}</title>
    
    <link rel="icon" href="/assets/icono.ico" type="image/x-icon">

    {# CSS base #}
    <link rel="stylesheet" href="/assets/styles/global.css" />
    <link rel="stylesheet" href="/assets/styles/header.css" />
    <link rel="stylesheet" href="/assets/styles/footer.css" />
    <icon>

    {% block styles %}{% endblock %}

    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>
<body>

    {% include 'parts/header.view.twig' %}

    <main class="main">
        {% block content %}{% endblock %}
    </main>

    {% include 'parts/footer.view.twig' %}

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const btnMenu = document.getElementById('btnMenu');
            const menu = document.getElementById('menu');
            if (btnMenu && menu) {
                btnMenu.addEventListener('click', () => menu.classList.toggle('active'));
            }
        });
    </script>

    {% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const btnUbicacion = document.getElementById('btnUbicacion');
    const ubicacionInfo = document.getElementById('ubicacionInfo');
    
    if (!btnUbicacion || !ubicacionInfo) return;

    // funcion para pedir el clima al backend
    const getClima = async (lat, lng) => {
        try {
            const res = await fetch(`/api/weather?lat=${lat}&lng=${lng}`);
            const data = await res.json();
            if (data.main) {
                const icon_code = data.weather[0].icon;
                const description = data.weather[0].description;
                const temp = Math.round(data.main.temp); 

                ubicacionInfo.innerHTML += `
    <div class="clima-info-ajax" style="display: flex; align-items: center; gap: 10px; margin-top: 10px; border-top: 1px solid #eee; padding-top: 10px;">
       
        <div>
            <p style="margin: 0; font-weight: bold; color: #333;">${temp}°C</p>
            <p style="margin: 0; font-size: 0.85rem; text-transform: capitalize; color: #666;">${description}</p>
        </div>
    </div>
`;
            }
        } catch (e) {
            console.error("error al traer el clima", e);
        }
    };

    // si ya tenemos las coords, pedimos clima de una
    const lat = localStorage.getItem('user_lat');
    const lng = localStorage.getItem('user_lng');
    if (lat && lng) {
        ubicacionInfo.style.display = 'block';
        btnUbicacion.style.display = 'none';
        getClima(lat, lng);
    }

    btnUbicacion.addEventListener('click', () => {
        if (!navigator.geolocation) return alert("no tenes gps");
        
        navigator.geolocation.getCurrentPosition((pos) => {
            const { latitude, longitude } = pos.coords;
            localStorage.setItem('user_lat', latitude);
            localStorage.setItem('user_lng', longitude);
            
            btnUbicacion.style.display = 'none';
            ubicacionInfo.style.display = 'block';
            getClima(latitude, longitude);
        });
    });
});
</script>
{% endblock %}
</body>
</html>