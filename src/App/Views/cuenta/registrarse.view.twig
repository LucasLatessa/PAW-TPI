{% extends 'layouts/app.view.twig' %}

{% block styles %}
<link rel="stylesheet" href="/assets/styles/equipos/index.css" />
{% endblock %}

{% block content %}
        <section class="login-container">
            <h1>Crear Cuenta</h1>
            {% if errorMessage %}
                <div class="alerta-error">
                    {{ errorMessage }}
                </div>
            {% endif %}
            
            <form action="" method="post" class="login-form">
                
                <div class="form-group">
                    <label for="nombre">Nombre</label>
                    <input type="text" id="nombre" name="nombre" value="{{ nombre_ingresado }}" required>
                </div>

                <div class="form-group">
                    <label for="apellido">Apellido</label>
                    <input type="text" id="apellido" name="apellido" value="{{ apellido_ingresado }}" required>
                </div>

                <div class="form-group">
                    <label for="email">Correo Electrónico</label>
                    <input type="email" id="email" name="email" value="{{ email_ingresado }}" required>
                </div>
                
                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="password" required>
                </div>

                <div class="form-group">
                    <label for="validarContraseña">Repetir Contraseña</label>
                    <input type="password" id="validarContraseña" name="password_confirm" required>
                </div>

                <div class="form-group">
                    <label for="palabraClave">Palabra Clave</label>
                    <input type="text" id="palabraClave" name="palabraClave" required>
                </div>

                <button type="submit" value="registrarse" class="btn-login">Registrarse</button>
            </form>

            <div class="registro-container">
                <small class="registro-selec">¿Ya tenés cuenta?</small>
                <a href="/cuenta/login" class="register-link">Iniciar Sesión</a>
            </div>
        </section>

{% endblock %}