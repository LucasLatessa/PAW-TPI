    <section class="auth-container">

        <header class="auth-header">
            <ion-icon name="football-outline" class="auth-icon"></ion-icon>
            <h1>Iniciar sesión</h1>
            <p>Accedé a tu de la Liga Chivilcoyana</p>
        </header>

        <form method="POST" action="" class="auth-form">

            <label for="email">Correo electrónico</label>
            <input type="email" id="email" name="email" placeholder="ejemplo@correo.com" required autofocus>

            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" placeholder="••••••••" required>

            <button type="submit" value="login" class="btn-login">
                Entrar al sistema
            </button>
        </form>

        <footer class="auth-footer">
            <p>¿No tenés cuenta?
