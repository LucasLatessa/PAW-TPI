<!DOCTYPE html>
<html lang="en">
<head>
    {% include 'parts/head.view.twig' %}
    <link rel="stylesheet" href="/assets/styles/listaEquipos.css" />
</head>
<body>
    <!--HEADER-->
    {% include 'parts/header.view.twig' %}

    <main>
        <!-- Header del Main -->
        <header class="header-equipos">
            <h1>EQUIPOS</h1>
        </header>

        <section class="equipos-grid">
            {% if listaEquipos|length > 0 %}
                {% for equipo in listaEquipos %}
                <article class="equipo-card">
                    <a href="/listaEquipos/equipo?id={{ equipo.id }}" class="equipo-link">
                        <div class="img-container">
                            <img src="/assets/equipos/{{ equipo.escudo }}" alt="{{ equipo.nombre }}" loading="lazy">
                        </div>
                        <div class="info-container">
                            <h3>{{ equipo.nombre }}</h3>
                        </div>
                    </a>
                </article>
                {% endfor %}
            {% else %}
                <div class="sin-datos">
                    <p>No hay equipos disponibles.</p>
                </div>
            {% endif %}
        </section>

        {% if hayLogin %}
            <a class="btn-accion" href="./torneo/cargarEquipo">Cargar equipo</a>
        {% endif %}
  
    </main>

    <!--FOOTER-->
    {% include 'parts/footer.view.twig' %}
</body>
</html>
