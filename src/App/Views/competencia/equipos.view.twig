<!DOCTYPE html>
<html lang="en">
<head>
    {% include 'parts/head.view.twig' %}
    <link rel="stylesheet" href="/assets/styles/equipos.css" />
</head>
<body>
    <!--HEADER-->
    {% include 'parts/header.view.twig' %}
    
    <main>
        <header class="header-equipo">
            <div class="header-content">
                <div class="info-equipo">
                    <h1>{{ equipo.nombre }}</h1>
                    <p>Creación: {{ equipo.fecha_creacion|date("d/m/Y") }}</p>
                </div>
                <div class="escudo-equipo">
                    <img src="/assets/equipos/{{ equipo.escudo }}" alt="Escudo de {{ equipo.nombre }}">
                </div>
            </div>
        </header>

        <section class="descripcion-equipo">
            <h2>Descripción</h2>
            <p>{{ equipo.descripcion }}</p>
        </section>


       <section class="detalles-equipo">
            
            <div class="fixture">
                <h3>FIXTURE</h3>
                {% if partidosEquipo.pendientes is empty %}
                    <p>No hay partidos pendientes.</p>
                {% else %}
                <table>
                    <thead>
                        <tr>
                            <th>FECHA</th> <th>HORA</th>
                            <th>PARTIDO</th>
                            <th>ESTADIO</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for partido in partidosEquipo.pendientes %}
                        <tr>
                            <td>{{ partido.fecha|date("d/m/Y") }}</td>
                            <td>{{ partido.horario|slice(0, 5) }}</td>
                            <td>{{ partido.nombre_local }} vs {{ partido.nombre_visitante }}</td>
                            <td>{{ partido.estadio }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% endif %}
            </div>

            <div class="resultados">
                <h3>RESULTADOS</h3>
                {% if partidosEquipo.jugados is empty %}
                    <p>Aún no jugó partidos.</p>
                {% else %}
                <table>
                    <thead>
                        <tr>
                            <th>FECHA</th>
                            <th>HORA</th>
                            <th>RESULTADO</th> <th>ESTADIO</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for resultado in partidosEquipo.jugados %}
                        <tr>
                            <td>{{ resultado.fecha|date("d/m/Y") }}</td>
                            <td>{{ resultado.horario|slice(0, 5) }}</td>
                            <td>
                                {{ resultado.nombre_local }} ({{ resultado.golesLocal }}) - ({{ resultado.golesVisitante }}) {{ resultado.nombre_visitante }}
                            </td>
                            <td>{{ resultado.estadio }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% endif %}
            </div>
        </section>
    </main>

    <!--FOOTER-->
    {% include 'parts/footer.view.twig' %}
</body>
</html>