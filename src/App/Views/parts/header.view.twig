            </li>
            <li id="ubicacionInfo" style="display:none;"></li>
            {# <li><a href="/reglamento">Reglamento</a></li> #}
            <!-- LOGIN MOBILE -->
            <li class="nav-login">
                {% if hayLogin %}
                    <a href="/login">Mi Perfil</a>
                {% else %}
                    <a href="/login">Iniciar sesión</a>
                {% endif %}
            </li>
        </ul>
    </nav>

    <!-- LOGIN DESKTOP -->
    {% if hayLogin %}
        <a class="header-login" href="/login" id="login">Mi Perfil</a>
    {% else %}
        <a class="header-login" href="/login" id="login">Iniciar sesion</a>
    {% endif %}
