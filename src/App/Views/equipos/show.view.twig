{% extends 'layouts/app.view.twig' %}

{% block styles %}
<link rel="stylesheet" href="/assets/styles/componentes/partido.css" />
<link rel="stylesheet" href="/assets/styles/equipos/show.css" />

{% endblock %}

{% block content %}

    <header class="header-main">
        <figure class="header-equipo-escudo">
            <img src="/assets/{{ equipo.escudo }}" alt="Escudo {{ equipo.nombre }}">
        </figure>
        <h1>{{ equipo.nombreInstitucional }}</h1>
    </header>

    <section class="club-layout">

        <div>
            <section class="sobre-club">
                <header class="sobre-club-header">
                    <h2>
                        <ion-icon name="alert-circle-outline" class="icon"></ion-icon>
                        Sobre el Club
                    </h2>
                </header>

                <article class="sobre-club-article">
                    <p>
                        {{ equipo.descripcion }}
                    </p>
                </article>

                <ul class="sobre-club-stats">
                    <li>
                        <span class="label">Fundación</span>
                        <strong>{{ equipo.fechaCreacion|date('d/m/Y') }}</strong>
                    </li>
                    <li>
                        <span class="label">Estadio</span>
                        <strong>{{ equipo.estadio.nombre }}</strong>
                    </li>
                </ul>
            </section>
            <section class="resultados-club">
                <header class="resultados-club-header">
                    <h2>
                        <ion-icon name="football-outline" class="icon"></ion-icon>
                        Últimos Resultados
                    </h2>
                </header>

                <ul class="resultados-club-list">
                    {% for partido in ultimosPartidos %}
                        {# Determinamos si el equipo que estamos viendo es local o visitante en este partido #}
                        {% set esLocal = (partido.equipo_local_id == equipo.id) %}
                        {% set golesPropio = esLocal ? partido.goles_local : partido.goles_visitante %}
                        {% set golesRival = esLocal ? partido.goles_visitante : partido.goles_local %}

                        {% set claseResultado = '' %}
                        {% set textoResultado = '' %}
                        
                        {% if golesPropio > golesRival %}
                            {% set claseResultado = 'result--win' %}
                            {% set textoResultado = 'Victoria' %}
                        {% elseif golesPropio < golesRival %}
                            {% set claseResultado = 'result--loss' %}
                            {% set textoResultado = 'Derrota' %}
                        {% else %}
                            {% set claseResultado = 'result--draw' %}
                            {% set textoResultado = 'Empate' %}
                        {% endif %}

                        <li>
                            <article class="result {{ claseResultado }}">
                                <time datetime="{{ partido.fecha_partido }}">
                                    {{ partido.fecha_partido|date('d/m/Y') }}
                                </time>

                                <span class="team local">{{ partido.nombre_local }}</span>

                                <strong class="score">
                                    {{ partido.goles_local }} - {{ partido.goles_visitante }}
                                </strong>

                                <span class="team">{{ partido.nombre_visitante }}</span>

                                <span class="badge">{{ textoResultado }}</span>

                            </article>
                        </li>
                    {% else %}
                        <p>No hay partidos registrados para este equipo.</p>
                    {% endfor %}
                </ul>
            </section>
        </div>

        <div>
            <section class="posicion-club">
                <h2>Posición Actual</h2>

                <p class="posicion-rank">
                    <strong>{{ posicion }}°</strong> / {{ totalEquipos }} Equipos
                </p>

                <ul class="posicion-stats">
                    <li>
                        <strong>{{ tabla.puntos }}</strong>
                        <span>Puntos</span>
                    </li>
                    <li>
                        <strong>{{ tabla.partidos_jugados }}</strong>
                        <span>Jugados</span>
                    </li>
                    <li>
                        <strong>
                            {{ tabla.diferencia_goles > 0 ? '+' : '' }}{{ tabla.diferencia_goles }}</strong>
                        <span>Diferencia</span>
                    </li>
                </ul>
            </section>

  
            <section class="proximo-partido-club">
                <h2>Próximo Partido</h2>

                {% if proxPartido %}
                    {% include 'componentes/partido.twig' with {
                        partido: proxPartido
                    } only %}
                {% else %}
                    <p>No hay partidos programados.</p>
                {% endif %}
            </section>
        </div>

    </section>

{% endblock %}