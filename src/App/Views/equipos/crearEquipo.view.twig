{% extends 'layouts/app.view.twig' %}

{% block styles %}
<link rel="stylesheet" href="/assets/styles/equipos/crearEquipo.css">
{% endblock %}

{% block content %}
        <header class="header-main">
            <h1>Crear Equipo</h1>
        </header>
        <section class="section-carga">
            <form method="POST" enctype="multipart/form-data" class="carga-form" action="">

                <label for="equipo">Nombre del equipo</label>
                <input id="equipo" name="equipo" value="{{equipo_ingresado}}" required>

                <label for="institucional">Nombre institucional del equipo</label>
                <input id="institucional" name="institucional" value="{{institucional_ingresado}}" required>
                
                <label for="fecha">Fecha de Creación</label>
                <input type="date" id="fecha" name="fecha" value="{{fecha_ingresada}}" required>
                   
                <label for="estadio">Nombre estadio</label>
                <input id="estadio" name="estadio" value="{{estadio_ingresado}}" required>

                <label for="descripcion">Descripcion</label>
                <textarea id="descripcion" name="descripcion" rows="4" required>{{descripcion_ingresada}}</textarea>

                <label for="imagen-drop-input" id="imagen-drop">
                    <span id="drop-text">Hacé clic o arrastrá la imagen aquí (Máx 1MB)</span>
                    <small id="file-name"> - Formatos aceptados: JPG, PNG</small>
                </label>
                <input type="file" id="imagen-drop-input" name="imagen" accept=".jpg, .png">

               
                {% if errorMessage is defined %}
                    <p class="error-message">{{ errorMessage }}</p>
                {% endif %}

                <button type="submit">Enviar</button>
            </form>
        </section>
{% endblock %}