{% extends 'layouts/app.view.twig' %}

{% block styles %}
<link rel="stylesheet" href="/assets/styles/equipos/crearEquipo.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<style>
  #map {
    height: 380px;
    width: 100%;
    border-radius: 10px;
    margin-top: 10px;
  }
  .map-help {
    font-size: 0.9rem;
    opacity: 0.8;
    margin-top: 6px;
  }
</style>
{% endblock %}

{% block content %}
<header class="header-main">
  <h1>{{ isEdit ? 'Editar Equipo' : 'Crear Equipo' }}</h1>
</header>

<section class="section-carga">
  <form method="POST" enctype="multipart/form-data" class="carga-form" action="">

    <label for="equipo">Nombre del equipo</label>
    <input id="equipo" name="equipo" value="{{ equipo.nombre ?? '' }}" required>

    <label for="institucional">Nombre institucional del equipo</label>
    <input id="institucional" name="institucional" value="{{ equipo.nombreInstitucional ?? '' }}" required>
    <label for="fecha">Fecha de Fundación</label>
    <input type="date" id="fecha" name="fecha" value="{{ equipo.fechaCreacion ?? '' }}"  required>

    <label for="estadio">Nombre estadio</label>
    <input id="estadio" name="estadio" value="{{ estadio.nombre ?? '' }}"  required>

    {# === NUEVO: Ubicación del estadio (lat/lng) === #}
    <label>Ubicación del estadio</label>
    <div id="map"></div>
    <p class="map-help">Hacé click en el mapa para marcar la ubicación (podés arrastrar el pin).</p>

    <input type="hidden" id="estadio_lat" name="estadio_lat" value="{{ estadio.latitud|default('') }}">
    <input type="hidden" id="estadio_lng" name="estadio_lng" value="{{ estadio.longitud|default('') }}">
    {# Opcional: guardar dirección en texto #}
    <input type="hidden" id="estadio_direccion" name="estadio_direccion" value="{{ estadio_direccion|default('') }}">
    {# === FIN NUEVO === #}

    <label for="descripcion">Descripcion</label>
    <textarea id="descripcion" name="descripcion" rows="4" required>{{ equipo.descripcion ?? '' }}</textarea>

    {% if isEdit and equipo.escudo %}
    <div class="imagen-actual">
        <p>Escudo actual:</p>
        <img src="/assets/escudos/{{ equipo.escudo }}" 
            alt="Imagen actual" 
            style="max-width: 200px;">
    </div>
    {% endif %}
    <label for="imagen" id="imagen-drop">
      Escudo (Imagen tamaño maximo 1MB)
      <label for="imagen-drop-input" id="imagen-drop">
        Escudo (Máx 1MB) - Formatos aceptados: JPG, PNG, SVG, WEBP
        <input type="file" id="imagen-drop-input" name="imagen" accept=".jpg, .jpeg, .png, .svg, .webp" {{ isEdit ? '' : 'required' }}>
    </label>
    </label>

    {% if errorMessage is defined %}
      <p class="error-message">{{ errorMessage }}</p>
    {% endif %}

    <button type="submit">Enviar</button>
  </form>
</section>

{# Leaflet JS #}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  // Centro inicial (si no hay coords previas, Buenos Aires)
  const defaultLat = -34.897;
  const defaultLng = -60.018;

  const inputLat = document.getElementById('estadio_lat');
  const inputLng = document.getElementById('estadio_lng');
  const inputDir = document.getElementById('estadio_direccion');

  const initialLat = inputLat.value ? parseFloat(inputLat.value) : defaultLat;
  const initialLng = inputLng.value ? parseFloat(inputLng.value) : defaultLng;

  const map = L.map('map').setView([initialLat, initialLng], 12);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors'
  }).addTo(map);

  let marker = null;

  function setCoords(lat, lng, doReverse = true) {
    inputLat.value = lat.toFixed(6);
    inputLng.value = lng.toFixed(6);

    if (!marker) {
      marker = L.marker([lat, lng], { draggable: true }).addTo(map);
      marker.on('dragend', (e) => {
        const pos = e.target.getLatLng();
        setCoords(pos.lat, pos.lng, true);
      });
    } else {
      marker.setLatLng([lat, lng]);
    }

    if (doReverse) reverseGeocode(lat, lng);
  }

  async function reverseGeocode(lat, lng) {
    try {
      const url = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`;
      const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
      if (!res.ok) return;
      const data = await res.json();
      inputDir.value = data.display_name || '';
    } catch (e) {
      // silencioso
    }
  }

  map.on('click', (e) => {
    setCoords(e.latlng.lat, e.latlng.lng, true);
  });

  // Si ya había coords cargadas desde backend, pintamos el pin sin reverse
  if (inputLat.value && inputLng.value) {
    setCoords(parseFloat(inputLat.value), parseFloat(inputLng.value), false);
  }
</script>
{% endblock %}