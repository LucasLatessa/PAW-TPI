{% extends 'layouts/app.view.twig' %}

{% block styles %}
<link rel="stylesheet" href="/assets/styles/equipos/index.css" />
{% endblock %}

{% block content %}
  <header class="header-main">
    <h1>Equipos</h1>
  </header>

  <section class="equipos-container">
    {% if equipos|length > 0 %}
      {% for equipo in equipos %}
          <a href="/equipos/equipo?id={{ equipo.id }}" class="equipo-link">

              <article class="equipo-card">
                  <figure class="equipo-escudo">
                      <img src="/assets/{{ equipo.escudo }}" alt="Escudo {{ equipo.nombre }}">
                  </figure>

                  <h2 class="equipo-nombre">{{ equipo.nombre }}</h2>

              </article>

          </a>
      {% endfor %}
    {% else %}
      <p>No hay equipos disponibles.</p>
    {% endif %}

    </section>
    <nav class="paginacion">
      {% if paginaActual > 1 %}
        <a href="/equipos?p={{ paginaActual - 1 }}" class="btn-pag"><</a>
      {% endif %}

      <span class="info-pag">Página {{ paginaActual }} de {{ totalPaginas }}</span>

      {% if paginaActual < totalPaginas %}
        <a href="/equipos?p={{ paginaActual + 1 }}" class="btn-pag">></a>
      {% endif %}
    </nav>

  {% if hayLogin %}
      <a class="btn-crear" href="./equipos/crearEquipo">Crear equipo</a>
  {% endif %}

{% endblock %}