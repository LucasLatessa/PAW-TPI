{% extends 'layouts/app.view.twig' %}

{% block styles %}
<link rel="stylesheet" href="/assets/styles/partidos/index.css" />
<link rel="stylesheet" href="/assets/styles/componentes/partido.css" />
<link rel="stylesheet" href="/assets/styles/paginador.css" />
{% endblock %}

{% block content %}
    <header class="header-main">
        <h1>Partidos</h1>
    </header>

    {# Filtros #}
    <form method="GET" class="filtros-partidos">
      <input type="hidden" name="per_page" value="{{ porPagina }}">
      <label>
          Categoria
          <select name="categoria">
              <option value="">Todas las categorías</option>

              {% for categoria in categorias %}
                  <option value="{{ categoria }}"
                      {% if filters.categoria is defined and filters.categoria == categoria %}
                          selected
                      {% endif %}
                  >
                      {{ categoria }}
                  </option>
              {% endfor %}
          </select>
      </label>

      <label>
          Fecha
          <input
              type="date"
              name="fecha"
              value="{{ filters.fecha is defined ? filters.fecha : '' }}"
          >
      </label>

      <label>
          Estado
          <select name="estado">
              <option value="">Todos los estados</option>

              <option value="programado"
                  {% if filters.estado is defined and filters.estado == 'programado' %}
                      selected
                  {% endif %}
              >
                  Programado
              </option>

              <option value="finalizado"
                  {% if filters.estado is defined and filters.estado == 'finalizado' %}
                      selected
                  {% endif %}
              >
                  Finalizado
              </option>
          </select>
      </label>

      <button type="submit">Filtrar</button>
    </form>
    <form method="GET" action="/partidos" id="formPerPage">
        <input type="hidden" name="categoria" value="{{ filters.categoria }}">
        <input type="hidden" name="fecha" value="{{ filters.fecha }}">
        <input type="hidden" name="estado" value="{{ filters.estado }}">
            <label for="per_page">Mostrar:</label>
            <select name="per_page" id="per_page" onchange="this.form.submit()">
                <option value="1"  {% if porPagina == 1 %} selected {% endif %}>1</option>
                <option value="4"  {% if porPagina == 4 %} selected {% endif %}>4</option>
                <option value="12" {% if porPagina == 12 %} selected {% endif %}>12</option>
                <option value="20" {% if porPagina == 20 %} selected {% endif %}>20</option>
            </select>
            <input type="hidden" name="p" value="1">
    </form>

    {# Lista de partidos #}

    <section class="lista-partidos">

        {% for partido in partidos %}
            {% include 'componentes/partido.twig' with {
                partido: partido
            } %}
        {% else %}
            <p>No hay partidos para los filtros seleccionados.</p>
        {% endfor %}
    </section>
    <nav class="paginacion">
    {% if totalPaginas > 0 %}
        {% if paginaActual > 1 %}
            <a href="/partidos?p={{ paginaActual - 1 }}&per_page={{ porPagina }}&categoria={{ filters.categoria }}&fecha={{ filters.fecha }}&estado={{ filters.estado }}" class="btn-pag"><</a>
        {% endif %}

        <span class="info-pag">Página {{ paginaActual }} de {{ totalPaginas }}</span>

        {% if paginaActual < totalPaginas %}
            <a href="/partidos?p={{ paginaActual + 1 }}&per_page={{ porPagina }}&categoria={{ filters.categoria }}&fecha={{ filters.fecha }}&estado={{ filters.estado }}" class="btn-pag">></a>
        {% endif %}
    {% endif %}
    </nav>
    {% if hayLogin %}
      <a class="btn-programar" href="/torneo/cargarPartido">Programar partido</a>
    {% endif %}

{% endblock %}