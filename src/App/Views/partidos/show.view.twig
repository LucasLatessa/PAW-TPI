{% extends 'layouts/app.view.twig' %}

{% block styles %}
<link rel="stylesheet" href="/assets/styles/partidos/show.css" />
{% endblock %}

{% block content %}
    <header class="header-main">
        <h1>{{ partido.fecha.nombre }}</h1>
        <p>{{ partido.torneo.nombre }}</p>
    </header>

    <section class="informacion-partido">
        <h2>Datos del partido</h2>
        <ul class="datos-informacion-partido">
            <li>
                <span class="card-icon">
                    <ion-icon name="calendar-outline" class="material-icons"></ion-icon>
                </span>
                <div>
                    <h4>Fecha</h4>
                    {% if partido.fechaPartido and partido.horaPartido %}
                        <p>{{ (partido.fechaPartido ~ ' ' ~ partido.horaPartido)|date('d/m/Y H:i') }} Hs.</p>
                    {% else %}
                        {% if hayLogin %}
                            <button type="button" class="btn-definir-fecha" onclick="openModal('modalFecha')">
                                Definir Fecha y Hora
                            </button>
                        {% else %}
                            <p>Fecha a confirmar</p>
                        {% endif %}
                    {% endif %}
                </div>
            </li>
            <li>
                <span class="card-icon">
                    <ion-icon name="location-outline" class="material-icons"></ion-icon>
                </span>
                <div>
                    <h4>Estadio</h4>
                    <p>{{ estadio.nombre ?? 'A definir' }}</p>
                    <p>{{ clima.visibility }}</p>
                </div>
            </li>
            <li>
                <span class="card-icon">
                    <ion-icon name="football-outline" class="material-icons"></ion-icon>
                </span>
                <div>
                    <h4>Torneo</h4>
                    <p>{{ partido.torneo.nombre }} - {{ partido.fecha.nombre }}</p>
                </div>
            </li>
        </ul>
    </section>
    <section class="informacion-clima">
        <h2>Clima del partido</h2>
        <ul class="datos-informacion-partido">
            {% if clima %}
                <li>
                    <span class="card-icon">
                        <img src="https://openweathermap.org/img/wn/{{ clima.weather.0.icon }}@4x.png" 
                            alt="Clima" 
                            style="width: 72px; height: 72px; object-fit: contain;">
                    </span>
                    <div>
                        <h4>Estado</h4>
                        <p>{{ clima.weather.0.description|capitalize }}</p>
                    </div>
                </li>
                <li>
                    <span class="card-icon">
                        <ion-icon name="thermometer-outline" class="material-icons"></ion-icon>
                    </span>
                    <div>
                        <h4>Temperatura</h4>
                        <p>{{ clima.temp.day|round(1) }}°C</p>
                    </div>
                </li>
                <li>
                    <span class="card-icon">
                        <ion-icon name="water-outline" class="material-icons"></ion-icon>
                    </span>
                    <div>
                        <h4>Humedad</h4>
                        <p>{{ clima.humidity }}%</p>
                    </div>
                </li>
            {% else %}
                <li>
                    <span class="card-icon">
                        <ion-icon name="help-circle-outline" class="material-icons"></ion-icon>
                    </span>
                    <div>
                        <h4>Aviso</h4>
                        <p>No disponible</p>
                    </div>
                </li>
            {% endif %}
        </ul>
    </section>

    <article class="partido">

        <!-- Equipo Local -->
        <section class="equipo equipo-local">
            <header class="equipo-header">
                <figure class="equipo-escudo">
                    <img src="/assets/{{ partido.equipoLocal.escudo }}"
                        alt="Escudo {{ partido.equipoLocal.nombre }}">
                </figure>
                <h2 class="equipo-nombre">{{ partido.equipoLocal.nombre }}</h2>
                <p class="equipo-condicion">Local</p>
            </header>
        </section>

        <!-- Resultado y estado -->
        <section class="partido-info">
            {% if hayLogin %}
                <form action="/partidos/cargarResultado" method="POST" class="form-resultado-rapido">
                    <input type="hidden" name="id_partido" value="{{ partido.id }}">
                    <div class="inputs-goles">
                        <input type="number" name="goles_local" min="0" placeholder=0 value={{ partido.golesLocal }} required>
                        <span>-</span>
                        <input type="number" name="goles_visitante" min="0" placeholder=0 value={{ partido.golesVisitante }} required>
                    </div>
                    <button type="submit" class="btn-guardar-chico">Guardar</button>
                </form>
            {% elseif partido.estado == 'programado' %}
                <span class="vs-text">VS</span>
            {% else %}
                <p class="partido-resultado">
                    <span class="goles-local">{{ partido.golesLocal }}</span>
                    <span class="separador">-</span>
                    <span class="goles-visitante">{{ partido.golesVisitante }}</span>
                </p>
            {% endif %}
        </section>

        <!-- Equipo Visitante -->
        <section class="equipo equipo-visitante">
            <header class="equipo-header">
                <figure class="equipo-escudo">
                   <img src="/assets/{{ partido.equipoVisitante.escudo }}"
                        alt="Escudo {{ partido.equipoVisitante.nombre }}">
                </figure>
                <h2 class="equipo-nombre">{{ partido.equipoVisitante.nombre }}</h2>
                <p class="equipo-condicion">Visitante</p>
            </header>
        </section>

    </article>
    <div id="modalFecha" class="modal-overlay" style="display:none;">
        <div class="modal-content">
            <header class="modal-header">
                <h3>Definir fecha y hora</h3>
                <button class="btn-close">&times;</button>
            </header>
            <form action="/partidos/definirHorario" method="POST" class="form-modal">
                <input type="hidden" name="id_partido" value="{{ partido.id }}">
                
                <div class="form-group">
                    <label for="fecha">Día del partido:</label>
                    <input type="date" name="fecha_partido" id="fecha" required>
                </div>

                <div class="form-group">
                    <label for="hora">Hora:</label>
                    <input type="time" name="hora_partido" id="hora" required>
                </div>

                <footer class="modal-footer">
                    <button type="submit" class="btn-guardar">Confirmar Horario</button>
                </footer>
            </form>
        </div>
    </div>
    <script src="/assets/js/components/paw.js"></script>
    <script src="/assets/js/appFechaHora.js"></script>

{% endblock %}