<article class="noticia-card">

    <a href="/noticias/noticia?id={{ noticia.id }}" class="noticia-link">

        {% if noticia.imagen %}
            <figure class="noticia-imagen">
                <img src="/assets/{{ noticia.imagen }}" alt="{{ noticia.titulo }}">
            </figure>
        {% endif %}

        <header class="noticia-body">
            <h2 class="noticia-titulo">{{ noticia.titulo }}</h2>

            <p class="noticia-descripcion">
                {{ noticia.descripcion }}
            </p>
        </header>

        <footer class="noticia-footer">
            <time datetime="">
                {{ noticia.fecha_publicacion }}
            </time>

            {% if noticia.autor %}
                <span class="autor">{{ noticia.autor }}</span>
            {% endif %}
        </footer>

    </a>

</article>