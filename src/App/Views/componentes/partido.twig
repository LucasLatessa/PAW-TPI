<article class="partido-card">

    <a href="/partidos/partido?id={{ partido.id }}">

        <header class="partido-header">
            <time datetime="{{ partido.fecha_partido }}">
                {{ partido.fechaPartido }} | {{ partido.horaPartido }}
            </time>

            <span class="barra-estado {{ partido.estado }}">
                {{ partido.estado }}
            </span>
        </header>

        <main class="partido-main">

            <article class="equipo local">
                <figure class="logo-equipo">
                    <img src="/assets/{{ partido.equipoLocal.escudo }}"
                        alt="Escudo {{ partido.equipoLocal.nombre }}">
                </figure>

                <h3 class="equipo-nombre">
                    {{ partido.equipoLocal.nombre }}
                </h3>
            </article>

            <span class="vs">
                {% if partido.estado == 'programado' %}
                    <span class="vs-text">VS</span>
                {% else %}
                    {{ partido.golesLocal ?? 0 }}
                    -
                    {{ partido.golesVisitante ?? 0 }}
                {% endif %}
            </span>

            <article class="equipo visitante">
                <figure class="logo-equipo">
                    <img src="/assets/{{ partido.equipoVisitante.escudo }}"
                        alt="Escudo {{ partido.equipoVisitante.nombre }}">
                </figure>

                <h3 class="equipo-nombre">
                    {{ partido.equipoVisitante.nombre }}
                </h3>
            </article>

        </main>

        <footer class="partido-footer">
            <p> {{partido.equipoLocal.estadio.nombre}}</p>
        </footer>
    </a>

</article>
