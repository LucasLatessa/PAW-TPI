{% extends 'layouts/app.view.twig' %}

{% block styles %}
<link rel="stylesheet" href="/assets/styles/noticias/show.css" />
{% endblock %}

{% block content %}
    <article class="noticia-detalle">

        <header class="noticia-header">
            <h1>{{ noticia.titulo }}</h1>

            <div class="meta">
                {% if noticia.fecha_publicacion %}
                  <time datetime="{{ noticia.fecha_publicacion|date('d/m/Y') }}">
                      {{ noticia.fecha_publicacion|date('d/m/Y') }}
                  </time>
                {% endif %}

                {% if noticia.autor %}
                  <span class="autor">Por: {{ noticia.autor }}</span>
                {% endif %}

                <span class="visitas">
                    {{ noticia.visitas }} visitas
                </span>
            </div>
        </header>

        {% if noticia.imagen %}
            <figure class="noticia-imagen-principal">
                <img src="/assets/noticias/{{noticia.imagen}}" alt="{{ noticia.titulo }}">
            </figure>
        {% endif %}


        <section class="noticia-contenido">
            {{ noticia.contenido }}
        </section>

        <footer class="noticia-footer">
            <a href="/noticias" class="volver">
                ← Volver a noticias
            </a>
        </footer>

        {% if hayLogin %}
          <a class="btn-crear" href="./editar?id={{ noticia.id }}">Editar noticia</a>
          <form action="/noticias/borrar?id={{ noticia.id }}" method="POST" 
              onsubmit="return confirm('¿Seguro que querés borrar esta noticia?');">
            <button type="submit" class="btn-delete">
                Borrar noticia
            </button>
        </form>
        {% endif %}
    </article>
    


{% endblock %}