{% extends 'layouts/app.view.twig' %}

{% block styles %}
<link rel="stylesheet" href="/assets/styles/noticias/create.css" />
{% endblock %}

{% block content %}
    <header class="header-main">
        <h1>Crear Noticia</h1>
    </header>
    <main class="section-carga">

        <form method="POST" enctype="multipart/form-data" class="carga-form" action="">
            
            <div class="form-group">
                <label for="titulo">Título de la noticia</label>
                <input id="titulo" name="titulo" type="text" value="{{titulo_ingresado}}" placeholder="Ej: Gran final del torneo de verano" required>
            </div>

            <div class="form-group">
                <label for="descripcion">Descripción Breve</label>
                <textarea id="descripcion" name="descripcion" placeholder="Un resumen que enganche al lector..." required>{{descripcion_ingresada}}</textarea>
            </div>

            <div class="form-group">
                <label for="contenido">Contenido Completo</label>
                <textarea id="contenido" name="contenido" class="textarea-contenido" placeholder="Desarrollá aqui toda la noticia ..." required>{{contenido_ingresado}}</textarea>
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label for="autor">Autor</label>
                    <input id="autor" name="autor" type="text" value="{{autor_ingresado}}" placeholder="Tu nombre" required>
                </div>

                <div class="form-group">
                    <label for="fecha">Fecha de Publicación</label>
                    <input type="date" id="fecha" name="fecha" value="{{fecha_ingresada}}" required>
                </div>
            </div>
            <div class="form-group">
                <label for="imagen-drop-input" id="imagen-drop">
                    <span id="drop-text">Hacé clic o arrastrá la imagen aquí (Máx 1MB)</span>
                    <small id="file-name"> - Formatos aceptados: JPG, PNG</small>
                </label>
                <input type="file" id="imagen-drop-input" name="imagen" accept=".jpg, .png">
            </div>

            {% if errorMessage is defined %}
                <p class="error-message">{{ errorMessage }}</p>
            {% endif %}

            <button type="submit" class="btn-enviar">Publicar Noticia</button>
        </form>
    </main>
{% endblock %}