{% extends 'layouts/app.view.twig' %}

{% block styles %}
<link rel="stylesheet" href="/assets/styles/torneos/index.css" />
<link rel="stylesheet" href="/assets/styles/paginador.css" />
{% endblock %}

{% block content %}
    <header class="header-main">
        <h1>Torneos</h1>
    </header>
        <form method="GET" action="/torneos" id="formPerPage">
            <label for="per_page">Mostrar:</label>
            <select name="per_page" id="per_page" onchange="this.form.submit()">
                <option value="1"  {% if porPagina == 1 %} selected {% endif %}>1</option>
                <option value="4"  {% if porPagina == 4 %} selected {% endif %}>4</option>
                <option value="12" {% if porPagina == 12 %} selected {% endif %}>12</option>
                <option value="20" {% if porPagina == 20 %} selected {% endif %}>20</option>
            </select>
            <input type="hidden" name="p" value="1">
        </form>


    <section class="torneos-section">

        <!-- TO-DO Filtro por categoria -->

        <ul class="torneos-container">
            {% for torneo in torneos %}
                <li><a href="/torneos/torneo?id={{ torneo.id }}" class="torneo-card">
                        <article class="card-contenedor">
                            <span class="card-icon">
                                <ion-icon name="trophy-outline" class="material-icons"></ion-icon>
                            </span>

                            <section class="card-details">
                                <span class="barra-status status-{{ torneo.estado }}">{{ torneo.estado == 'activo' ? 'En Curso' : 'Finalizado' }}</span>
                                <h3 class="card-title">{{ torneo.nombre }} {{ torneo.temporada }}</h3>
                                <p class="card-subtitle">Categoria: {{ torneo.categoria }}</p>
                            </section>
                        </article>
                    </a>
                </li>
            {% else %}
              <p>No hay torneos publicados.</p>
            {% endfor %}
        </ul>

    </section>
    <nav class="paginacion">
        {% if totalPaginas > 0 %}
            {% if paginaActual > 1 %}
                <a href="/torneos?p={{ paginaActual - 1 }}&per_page={{ porPagina }}" class="btn-pag"><</a>
            {% endif %}

            <span class="info-pag">Página {{ paginaActual }} de {{ totalPaginas }}</span>

            {% if paginaActual < totalPaginas %}
                <a href="/torneos?p={{ paginaActual + 1 }}&per_page={{ porPagina }}" class="btn-pag">></a>
            {% endif %}
        {% endif %}
    </nav>
        
        {% if hayLogin %}
            <a class="btn-crear" href="/torneos/crearTorneo">Crear Torneo</a>
        {% endif %}

{% endblock %}