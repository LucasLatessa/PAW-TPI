{% extends 'layouts/app.view.twig' %}

{% block styles %}
<link rel="stylesheet" href="/assets/styles/torneos/torneo.css" />
<link rel="stylesheet" href="/assets/styles/componentes/tabla-posiciones.css" />
<link rel="stylesheet" href="/assets/styles/componentes/partido.css" />
{% endblock %}

{% block content %}
    <header class="header-main">
        <h1>{{ torneo.nombre }} {{ torneo.temporada }}</h1>
    </header>

    <main class="torneo-main">
        <section class="informacion-torneo">
            <article>
                <span class="card-icon">
                    <ion-icon name="alert-circle-outline" class="material-icons"></ion-icon>
                </span>
                <div>
                    <h4>Estado</h4>
                    <p class="barra-status status-{{ torneo.estado }}">
                        {{ torneo.estado == 'activo' ? 'En Curso' : 'Finalizado' }}</p>
                </div>
            </article>
            <article>
                <span class="card-icon">
                    <ion-icon name="people-outline" class="material-icons"></ion-icon>
                </span>
                <div>
                    <h4>Equipos</h4>
                    <p>{{ cantEquipos }} equipos</p>
                </div>
            </article>
            <article>
                <span class="card-icon">
                    <ion-icon name="calendar-outline" class="material-icons"></ion-icon>
                </span>
                <div>
                    <h4>Inicio</h4>
                    <p>{{ torneo.fecha_inicio }}</p>
                </div>
            </article>
            {% if torneo.fecha_fin is not empty  %}
              <article>
                  <span class="card-icon">
                      <ion-icon name="calendar-outline" class="material-icons"></ion-icon>
                  </span>
                  <div>
                      <h4>Final</h4>
                      <p>{{ torneo.fecha_fin }}</p>
                  </div>
              </article>
            {% endif %}
        </section>

        <section class="tabla-posiciones-torneo">
            <div class="data">
                <h2>
                    <ion-icon name="stats-chart-outline" class="icon"></ion-icon> Tabla de Posiciones
                </h2>
                <a href="/torneos/torneo/tabla?id={{ torneo.id }}" class="tabla-completa">Ver tabla completa <ion-icon
                        name="arrow-forward-outline"></ion-icon></a>
            </div>
            {% include 'componentes/tabla-posiciones.twig' with {
                equipos: tabla,
                limit: "8",
                variant: 'simple'
            } %}
        </section>

        <section class="sobre-torneo">
            <h3>Sobre el torneo</h3>
            <p>{{ torneo.descripcion }}</p>
        </section>

        <section class="partidos-torneo">
            <div class="data">
                <h2> <ion-icon name="football-outline" class="icon"></ion-icon> Partidos</h2>
                <a href="/torneos/torneo/fixture?id={{ torneo.id }}" class="fixture-completo">Ver fixture completo <ion-icon
                        name="arrow-forward-outline"></ion-icon></a>
            </div>

            <section class="lista-partidos-torneo">
                {% if ultimosPartidos|length > 0 %}
                  {% for partido in ultimosPartidos %}
                    {% include 'componentes/partido.twig' with {
                      partido: partido
                    } %}
                  {% endfor %}
                {% else %}
                    <p>No hay partidos para este torneo.</p>
                {% endif %}
            </section>
            {% if hayLogin %}
                <a class="btn-programar" href="/torneo/cargarPartido?id={{ torneo.id }}">Programar partido</a>
            {% endif %}
        </section>
     


      </main>

{% endblock %}