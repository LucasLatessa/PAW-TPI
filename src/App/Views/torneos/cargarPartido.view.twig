{% extends 'layouts/app.view.twig' %}

{% block styles %}
<link rel="stylesheet" href="/assets/styles/partidos/crearPartido.css">
{% endblock %}

{% block content %}

        <header class="header-main">
            <h1>Crear Partido</h1>
        </header>
        <main class="section-carga">

        {% if hayLogin %}
            <form method="POST" action="" class="carga-form">
                
                {# Si el torneo ya viene prefijado #}
                {% if torneo %}
                    <input type="hidden" name="id-torneo" value="{{ torneo.id }}">
                {% endif %}

                <div class="form-group">
                    <label for="id-torneo">Torneo</label>
                    <select name="id-torneo" id="id-torneo" required 
                        {% if torneo %} disabled {% endif %} 
                        onchange="location.href='/torneo/cargarPartido?id=' + this.value">
                        {% if torneo %}
                            <option value="{{ torneo.id }}" selected>{{ torneo.nombre }}</option>
                        {% else %}
                            <option value="" disabled selected>Seleccioná un torneo</option>
                            {% for t in listaTorneos %}
                                <option value="{{ t.id }}" {{ t.id == idSeleccionado ? 'selected' : '' }}>{{ t.nombre }}</option>
                            {% endfor %}
                        {% endif %}
                    </select>
                </div>

                <div class="form-group">
                    <label for="fecha-torneo">Número de Fecha (Jornada)</label>
                    <input type="number" name="fecha-torneo" id="fecha-torneo" min="1" max="20" 
               value="{{ fecha_nro_ingresada|default('') }}" placeholder="Ej: 1" required>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="id-equipo-local">Equipo Local</label>
                        <select name="id-equipo-local" id="id-equipo-local" required>
                            <option value="" disabled selected>Seleccionar local</option>
                            {% for equipo in equiposTorneo %}
                                <option value="{{ equipo.equipo.id }}">{{ equipo.equipo.nombre }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="id-equipo-visitante">Equipo Visitante</label>
                        <select name="id-equipo-visitante" id="id-equipo-visitante" required>
                            <option value="" disabled selected>Seleccionar visitante</option>
                            {% for equipo in equiposTorneo %}
                                <option value="{{ equipo.equipo.id }}">{{ equipo.equipo.nombre }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="fecha">Día del Partido</label>
                        <input type="date" id="fecha" name="fecha" value="{{ fecha_dia_ingresada|default('') }}" required>
                    </div>
                    <div class="form-group">
                        <label for="hora">Horario</label>
                        <input type="time" id="hora" name="hora" value="{{ hora_ingresada|default('') }}" required>
                    </div>
                </div>
                {% if errorMessage %}
                    <div class="error-message" style="margin-bottom: 1.5rem;">
                        {{ errorMessage }}
                    </div>
                {% endif %}

                <button type="submit" class="btn-enviar">Cargar Partido</button>
            </form>
        {% else %}
            <div class="mensaje-login">
                <p>Debés iniciar sesión para poder cargar un partido.</p>
                <a href="/login" class="btn-login-redirect">Ir al Login</a>
            </div>
        {% endif %}
{% endblock %}