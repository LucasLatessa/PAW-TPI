{% extends 'layouts/app.view.twig' %}

{% block styles %}
<link rel="stylesheet" href="/assets/styles/torneos/creartorneo.css">
{% endblock %}

{% block content %}
    <header class="header-main">
        <h1>Crear Torneo</h1>
    </header>
    <main class="section-carga">
        {% if hayLogin %}
            <form method="POST" action="/torneos/crearTorneo" class="carga-form">
                
                <div class="form-group">
                    <label for="nombre-torneo">Nombre del Torneo</label>
                    <input type="text" id="nombre-torneo" name="nombre_torneo" placeholder="Ej: Apertura 2026" required>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="categoria">Categoría</label>
                        <input type="text" id="categoria" name="categoria" placeholder="Ej: Senior" required>
                    </div>
                    <div class="form-group">
                        <label for="temporada">Temporada</label>
                        <input type="text" id="temporada" name="temporada" placeholder="Ej: 2026" required>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="descripcion">Descripción</label>
                    <textarea id="descripcion" name="descripcion" placeholder="Contanos un poco sobre el torneo..."></textarea>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="fechaInicio">Fecha Inicio</label>
                        <input type="date" id="fechaInicio" name="fechaInicio" required>
                    </div>
                    <div class="form-group">
                        <label for="fechaFin">Fecha Fin</label>
                        <input type="date" id="fechaFin" name="fechaFin" required>
                    </div>
                </div>

                <button type="submit" class="btn-enviar">Crear Torneo</button>
            </form>
        {% else %}
            <div class="mensaje-login">
                <p>Debés iniciar sesión para poder crear un torneo.</p>
                <a href="/login" class="btn-login-redirect">Ir al Login</a>
            </div>
        {% endif %}
    </main>
{% endblock %}