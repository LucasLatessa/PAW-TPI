<!DOCTYPE html>
<html lang="es">
<head>
    {% include 'parts/head.view.twig' %}
    <link rel="stylesheet" href="/assets/styles/cargarResultados.css" />
</head>
<body>
    {% include 'parts/header.view.twig' %}
    
    <main class="main-container">
        <header class="page-header">
            <h1>Cargar Resultados</h1>
            {% if torneo %}
                <h2>{{ torneo.nombre }}</h2>
            {% endif %}
        </header>

        <section class="partidos-grid">
            {% for partido in partidosACargar %}
                <form class="partido-card" action="/torneo/cargarResultado" method="POST">
                    
                    <input type="hidden" name="id_partido" value="{{ partido.id }}">
                    <input type="hidden" name="torneo_id" value="{{ torneo.id }}">

                    <div class="partido-info">
                        <span>Fecha Nº {{ partido.fechaTorneo }} - {{ partido.fecha|date("d/m/Y") }} - {{ partido.horario|slice(0, 5) }}</span>
                    </div>

                    <div class="enfrentamiento">
                        <div class="equipo local">
                            <span class="nombre-equipo">{{ partido.equipoLocal.nombre }}</span>
                            <input type="number" name="golesLocal" class="input-goles" min="0" required placeholder="-">
                        </div>

                        <div class="vs">VS</div>

                        <div class="equipo visitante">
                            <input type="number" name="golesVisitante" class="input-goles" min="0" required placeholder="-">
                            <span class="nombre-equipo">{{ partido.equipoVisitante.nombre }}</span>
                        </div>
                    </div>

                    <button type="submit" class="btn-guardar">Confirmar Resultado</button>
                </form>

            {% else %}
                <div class="no-data">
                    <p>¡Al día! No hay partidos pendientes de carga para este torneo.</p>
                    
                </div>
            {% endfor %}
            <a href="/torneo?id={{ torneo.id }}" class="btn-volver">Volver</a>
        </section>
    </main>

    {% include 'parts/footer.view.twig' %}
</body>
</html>