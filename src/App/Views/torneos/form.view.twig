{% extends 'layouts/app.view.twig' %}

{% block styles %}
<link rel="stylesheet" href="/assets/styles/torneos/crearTorneo.css">
{% endblock %}

{% block content %}
    <header class="header-main">
        <h1>{{ isEdit ? 'Editar Torneo' : 'Crear Torneo' }}</h1>
    </header>
    <main class="section-carga">
        {% if hayLogin %}
            <form method="POST" action="{{ action }}" class="carga-form">
                
                <div class="form-group">
                    <label for="nombre-torneo">Nombre del Torneo</label>
                    <input type="text" id="nombre-torneo" name="nombre_torneo" placeholder="Ej: Apertura 2026" value="{{ torneo.nombre ?? '' }}"required>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="categoria">Categoría</label>
                        <input type="text" id="categoria" name="categoria" placeholder="Ej: Senior" value="{{ torneo.categoria ?? '' }}" required>
                    </div>
                    <div class="form-group">
                        <label for="temporada">Temporada</label>
                        <input type="text" id="temporada" name="temporada" placeholder="Ej: 2026" value="{{ torneo.temporada ?? '' }}" required>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="descripcion">Descripción</label>
                    <textarea id="descripcion" name="descripcion" placeholder="Contanos un poco sobre el torneo...">{{ torneo.descripcion ?? '' }}</textarea>
                </div>

                {% if not isEdit %}
                <div class="form-group">
                    <div class="opciones-fixture-row">
                        <button type="button" id="btn-abrir-modal" class="btn-secundario">
                            <ion-icon name="add-circle-outline"></ion-icon> Seleccionar Equipos
                        </button>

                        <label class="check-fixture-automatico">
                            <input type="checkbox" name="crear_fixture" value="1">
                            <span>Fixture automático</span>
                        </label>
                    </div>
                    
                    <div id="equipos-seleccionados-contador" class="contador-badge">
                        0 equipos seleccionados
                    </div>
                </div>
                {% endif %}

                <div class="form-row">
                    <div class="form-group">
                        <label for="fechaInicio">Fecha Inicio</label>
                        <input type="date" id="fechaInicio" name="fechaInicio" value="{{ torneo.fechaInicio ?? '' }}" required>
                    </div>
                    <div class="form-group">
                        <label for="fechaFin">Fecha Fin</label>
                        <input type="date" id="fechaFin" name="fechaFin" value="{{ torneo.fechaFin ?? '' }}" required>
                    </div>
                </div>
                

                <button type="submit" class="btn-enviar">{{ isEdit ? 'Editar Torneo' : 'Crear Torneo' }}</button>
                <div id="modal-equipos" class="modal">
                    <div class="modal-content">
                        <header class="modal-header">
                            <h3>Seleccionar Equipos</h3>
                            <span class="btn-cerrar">&times;</span>
                        </header>
                        <div class="modal-body">
                            <div class="buscador-equipos">
                                <input type="text" id="filtro-equipos" placeholder="Buscar equipo...">
                            </div>
                            <label>
                                <input type="checkbox" id="check-seleccionar-todos"> Seleccionar todos los visibles
                            </label>
                            <div class="lista-equipos-check">
                                {% for equipo in equipos %}
                                <label class="equipo-check-item">
                                    <input type="checkbox" name="equipos_ids[]" value="{{ equipo.id }}" class="equipo-checkbox">
                                    <img src="/assets/escudos/{{ equipo.escudo }}" alt="" class="mini-escudo">
                                    <span>{{ equipo.nombre }}</span>
                                </label>
                                {% endfor %}
                            </div>
                        </div>
                        <footer class="modal-footer">
                            <button type="button" id="btn-confirmar-equipos" class="btn-enviar">Confirmar Selección</button>
                        </footer>
                    </div>
                </div>
            </form>
            
        {% else %}
            <div class="mensaje-login">
                <p>Debés iniciar sesión para poder crear un torneo.</p>
                <a href="/login" class="btn-login-redirect">Ir al Login</a>
            </div>
        {% endif %}
    </main>
    <script src="/assets/js/components/paw.js"></script>
    <script src="/assets/js/appCrearTorneo.js"></script>
{% endblock %}
